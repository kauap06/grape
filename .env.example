# Grape - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env: it contains credentials.

# Application
APP_NAME="Grape"
APP_VERSION=1.0.0
# Deixe false. Use APP_DEBUG=1 apenas temporariamente, ao investigar um erro.
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
# Endereco que os convidados usam (ex.: https://SEU_IP_RADMIN). Vazio = host da requisicao.
APP_BASE_URL=

# Database
# Crie um usuario dedicado, com permissao apenas no banco grape_calls.
# Nao use root e nao deixe a senha em branco.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grape_calls
DB_USERNAME=grape
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_NAME=grape_session
SESSION_LIFETIME=7200
# true quando servido por HTTPS (recomendado; o padrao do projeto detecta sozinho)
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# WebSocket Server
# 127.0.0.1 = acessivel apenas via reverse proxy (nunca exponha 8081 direto).
WS_HOST=127.0.0.1
WS_PORT=8081
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=10000
WS_MAX_MESSAGE_SIZE=1048576
# Valida o cabecalho Origin das conexoes WebSocket. Nao desative.
WS_CHECK_ORIGIN=true

# WebRTC
WEBRTC_STUN_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]'
WEBRTC_TURN_SERVERS='[]'
WEBRTC_ICE_TRANSPORT_POLICY=all
WEBRTC_BUNDLE_POLICY=max-bundle
WEBRTC_RTCP_MUX_POLICY=require

# Room Settings
ROOM_MAX_PARTICIPANTS=10
ROOM_INVITE_CODE_LENGTH=8
ROOM_CLEANUP_INACTIVE_HOURS=24
ROOM_PARTICIPANT_TIMEOUT_SECONDS=30

# Security
SECURITY_CSRF_TOKEN_LENGTH=32
SECURITY_RATE_LIMIT_API_REQUESTS=60
SECURITY_RATE_LIMIT_API_WINDOW=60
SECURITY_RATE_LIMIT_WS_MESSAGES=100
SECURITY_RATE_LIMIT_WS_WINDOW=60
# Origens extras permitidas no WebSocket (vazio = somente a mesma origem).
SECURITY_ALLOWED_ORIGINS='[]'

# Logging
# info (padrao) | warning | error. Evite debug: grava dados sensiveis.
LOG_LEVEL=info
LOG_PATH=logs
LOG_MAX_FILES=30
