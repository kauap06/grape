{
    "name": "grape/platform",
    "description": "Grape - Real-time voice, video, and screen sharing platform using PHP, WebRTC, and WebSocket",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cboden/ratchet": "^0.4.4",
        "react/socket": "^1.12",
        "react/event-loop": "^1.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "GamingCalls\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}