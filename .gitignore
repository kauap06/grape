# Logs e dados gerados em execucao
logs/*
!logs/.gitkeep
*.log

# Banco de dados portavel: dados contem senhas e informacoes de usuario - NUNCA versionar
portable/mariadb/data/

# PHP portavel: php.ini contem caminhos absolutos locais (opcache.file_cache) - criar por instalacao
portable/php/php.ini

# Sessoes PHP: dados de sessao em tempo de execucao - nao versionar
data/sessions/

# Credenciais e segredos - nunca versionar
.env
config/local.php

# Runtime portavel: PHP, MariaDB, Caddy e Composer estao versionados
# para instalacao zero-configuracao ("baixar e usar").
# O que permanece fora: dados do banco, php.ini com caminhos locais, sessoes, credenciais.

# Dependencias (recriaveis com composer install)
vendor/

# Instalador de CA gerado por make-guest-installer (especifico do host)
deploy/ca/dist/caddy-root.crt
deploy/ca/dist/install-ca.bat

# Arquivos do sistema e do editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Pacotes gerados (distribuicao)
*.zip